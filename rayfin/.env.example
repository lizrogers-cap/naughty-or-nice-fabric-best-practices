# Placeholder template only. Real values never leave your machine.
#
# `npx rayfin up` / `npx rayfin dev` write the real file (rayfin/.env) for you;
# you should not need to fill this in by hand. Copy to rayfin/.env only if you
# are wiring an environment manually.

# Backend coordinates, written by the Rayfin CLI (frontend reads the VITE_ copies
# that `rayfin env --framework vite` projects into packages/frontend/.env.local).
RAYFIN_PUBLIC_API_URL=
RAYFIN_PUBLIC_PUBLISHABLE_KEY=

# Vite-facing names the frontend reads via import.meta.env
VITE_RAYFIN_API_URL=
VITE_RAYFIN_PUBLISHABLE_KEY=

# Optional overrides for the Node seed scripts (scripts/lib/rayfin-node.ts)
# RAYFIN_API_URL=
# RAYFIN_PUBLISHABLE_KEY=
# RAYFIN_ENTRA_TOKEN=
